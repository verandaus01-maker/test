# Database Configuration
DATABASE_URL=postgresql+asyncpg://leaduser:leadpassword@localhost:5432/leadscraperdb
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# API Keys for Data Enrichment (Optional but Recommended)
OPENAI_API_KEY=
HUNTER_IO_API_KEY=
CLEARBIT_API_KEY=
FULLCONTACT_API_KEY=
PEOPLEDATALABS_API_KEY=
BUILT_WITH_API_KEY=
PIPL_API_KEY=

# Scraping Configuration
MAX_CONCURRENT_SCRAPERS=5
REQUEST_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Proxy Configuration
PROXY_ENABLED=false
PROXY_ROTATION_URL=
PROXY_USERNAME=
PROXY_PASSWORD=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=5000

# Email Configuration (for notifications and verification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@yourcompany.com
SMTP_FROM_NAME=Lead Scraper System

# LinkedIn Scraping (if using official API)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# Google Maps API
GOOGLE_MAPS_API_KEY=

# CRM Integration Keys
HUBSPOT_API_KEY=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_USERNAME=
SALESFORCE_PASSWORD=
SALESFORCE_SECURITY_TOKEN=
PIPEDRIVE_API_KEY=

# Webhook Configuration
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT=10

# Storage Configuration
STORAGE_TYPE=local  # local, s3, gcs
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_REGION=us-east-1

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_TRACK_STARTED=true
CELERY_TASK_TIME_LIMIT=3600

# Application Settings
APP_NAME=Lead Scraping System
APP_VERSION=1.0.0
ENVIRONMENT=development  # development, staging, production
DEBUG=true
LOG_LEVEL=INFO

# Data Retention (days)
DATA_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# Feature Flags
FEATURE_AI_SCORING=true
FEATURE_AUTO_ENRICHMENT=true
FEATURE_TECH_DETECTION=true
FEATURE_SOCIAL_SCRAPING=true
FEATURE_EMAIL_VERIFICATION=true
FEATURE_PHONE_VALIDATION=true

# Compliance
GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_PROCESSING_CONSENT_REQUIRED=true

# Monitoring & Analytics
SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
MIXPANEL_TOKEN=

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_APP_NAME=Lead Scraper Pro
